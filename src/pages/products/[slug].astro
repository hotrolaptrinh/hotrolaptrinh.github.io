---
import Base from "../../layouts/Base.astro";
import ProductDetail from "../../components/ProductDetail.tsx";
import Navbar from "../../components/Navbar.tsx";
import Footer from "../../components/Footer.tsx";
import { getCollection } from "astro:content";
import type { Product } from "../../types";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

const { project } = Astro.props;

const product: Product = {
    id: project.slug,
    title: project.data.title,
    price: project.data.sale || project.data.price || 0,
    originalPrice: project.data.price || 0,
    description: project.body || "Mô tả đang cập nhật...",
    category:
        project.data.category === "web"
            ? "Website"
            : project.data.category === "app"
              ? "Mobile App"
              : project.data.category === "script"
                ? "AI/Data"
                : "Desktop",
    techStack: project.data.tags || [],
    image: project.data.thumbnail || "https://via.placeholder.com/800x450",
    rating: 4.5,
    sales: 0,
    author: "Admin",
    desc: project.data.desc || "Mô tả đang cập nhật...",
    images: project.data.images || [],
    demo: project.data.demo || "",
    setup: project.data.setup || [],
    changelog: project.data.changelog || [],
    require: project.data.require || [],
};
---

<Base title={`${product.title} - CodeStore`}>
    <div class="min-h-screen bg-white font-sans text-gray-900">
        <Navbar client:load />
        <main>
            <ProductDetail client:load product={product} />
        </main>
        <Footer client:load />
    </div>
</Base>
